<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.netlivecowork</groupId>
    <artifactId>netlivecowork-channel</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>channel-infra</artifactId>
  <name>channel-infra</name>
  <description>层共享基础设施：SQLite 事务、JSON、标识、摘要。无业务逻辑，不属于任何层</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>ban-layer-dependencies</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.netlivecowork:channel-contract</exclude>
                    <exclude>com.netlivecowork:channel-l1</exclude>
                    <exclude>com.netlivecowork:channel-l2</exclude>
                    <exclude>com.netlivecowork:channel-l3</exclude>
                    <exclude>com.netlivecowork:channel-app</exclude>
                  </excludes>
                  <message>INV-47：共享基础设施不得依赖任何层或公共契约。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
