<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.netlivecowork</groupId>
    <artifactId>netlivecowork-channel</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>channel-app</artifactId>
  <name>channel-app</name>
  <description>装配层：Spring Boot 启动、管理端 API、Adapter webhook 与 L3 事件接收入口</description>

  <properties>
    <channel.executable.outputDirectory>${project.build.directory}</channel.executable.outputDirectory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.netlivecowork</groupId>
      <artifactId>channel-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>com.netlivecowork</groupId>
      <artifactId>channel-infra</artifactId>
    </dependency>
    <dependency>
      <groupId>com.netlivecowork</groupId>
      <artifactId>channel-l1</artifactId>
    </dependency>
    <dependency>
      <groupId>com.netlivecowork</groupId>
      <artifactId>channel-l2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.netlivecowork</groupId>
      <artifactId>channel-l3</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Give Spring Boot a separate input so repackage does not rename it in place. -->
          <outputDirectory>${project.build.directory}/plain</outputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <outputDirectory>${channel.executable.outputDirectory}</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
