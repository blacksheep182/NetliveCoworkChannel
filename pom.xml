<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.netlivecowork</groupId>
  <artifactId>netlivecowork-channel</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NetliveCowork Channel</name>
  <description>Channel 三层架构实现：L1 协议适配 / L2 公共应用 / L3 后端访问</description>

  <modules>
    <module>channel-contract</module>
    <module>channel-infra</module>
    <module>channel-l1</module>
    <module>channel-l2</module>
    <module>channel-l3</module>
    <module>channel-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <sqlite-jdbc.version>3.49.1.0</sqlite-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.netlivecowork</groupId>
        <artifactId>channel-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.netlivecowork</groupId>
        <artifactId>channel-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.netlivecowork</groupId>
        <artifactId>channel-l1</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.netlivecowork</groupId>
        <artifactId>channel-l2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.netlivecowork</groupId>
        <artifactId>channel-l3</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
