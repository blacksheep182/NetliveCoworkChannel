<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.netlivecowork</groupId>
    <artifactId>netlivecowork-channel</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>channel-contract</artifactId>
  <name>channel-contract</name>
  <description>公共数据契约与层间端口（data-contracts.md / l1-adapter.md / l2-application.md / l3-backend.md）</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>ban-layer-dependencies</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.netlivecowork:channel-infra</exclude>
                    <exclude>com.netlivecowork:channel-l1</exclude>
                    <exclude>com.netlivecowork:channel-l2</exclude>
                    <exclude>com.netlivecowork:channel-l3</exclude>
                    <exclude>com.netlivecowork:channel-app</exclude>
                  </excludes>
                  <message>INV-47：公共契约不得依赖任何层或基础设施实现。</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
